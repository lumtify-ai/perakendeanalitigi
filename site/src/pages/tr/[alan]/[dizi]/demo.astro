---
// site/src/pages/tr/[alan]/[dizi]/demo.astro
import { getCollection, getEntry } from 'astro:content'
import Temel from '../../../../layouts/Temel.astro'
import KirintiYolu from '../../../../components/KirintiYolu.astro'
import Demo from '../../../../components/Demo.astro'

export async function getStaticPaths() {
  const diziler = await getCollection('dizi')
  return diziler
    .filter((girdi) => girdi.data.demo)
    .map((girdi) => {
      const [alan, dizi] = girdi.id.split('/')
      return { params: { alan, dizi }, props: { girdi } }
    })
}

const { girdi } = Astro.props
const [alanId, diziId] = girdi.id.split('/')
const alanGirdi = await getEntry('alan', alanId)

const aciklama = `${girdi.data.baslik} demosu: parametreleri değiştirin, önerinin nasıl değiştiğini görün.`
---

<Temel baslik={`${girdi.data.baslik} · Demo`} aciklama={aciklama}>
  <KirintiYolu
    basamaklar={[
      { ad: alanGirdi!.data.baslik, adres: `/tr/${alanId}/` },
      { ad: girdi.data.baslik, adres: `/tr/${alanId}/${diziId}/` },
      { ad: 'Demo' },
    ]}
  />

  <h1>{girdi.data.baslik} — Demo</h1>
  <p>{aciklama}</p>

  <Demo dizi={diziId} />
</Temel>
