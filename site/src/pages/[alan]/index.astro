---
// site/src/pages/[alan]/index.astro
import { getCollection, render } from 'astro:content'
import Temel from '../../layouts/Temel.astro'
import KirintiYolu from '../../components/KirintiYolu.astro'
import AlgoritmaSatiri from '../../components/AlgoritmaSatiri.astro'
import { asamaBul } from '../../data/harita'
import { alanYazilari } from '../../lib/agac'
import { alanBasligi } from '../../lib/alanBasligi'
import { diziBaglari, fazBasamagi } from '../../lib/haritaGirdisi'

export async function getStaticPaths() {
  const alanlar = await getCollection('alan')
  return alanlar.map((girdi) => ({ params: { alan: girdi.id }, props: { girdi } }))
}

const { girdi } = Astro.props
const { Content } = await render(girdi)

const [tumDiziler, tumYazilar] = await Promise.all([
  getCollection('dizi'),
  getCollection('yazi'),
])

const diziler = tumDiziler.filter((d) => d.data.alan === girdi.id)
const tekilYazilar = alanYazilari(tumYazilar, girdi.id)

const baslik = alanBasligi(girdi.id, girdi.data)

// Temeller haritada yok: onun yerine algoritma bölümü değil, raf
// bağlantıları (Sözlük, Veri seti) basılır.
const asama = asamaBul(girdi.id)?.asama
const baglar = diziBaglari(tumDiziler, tumYazilar)

const isaretleme = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: baslik,
  description: girdi.data.tanim,
  inLanguage: 'tr',
}
---

<Temel baslik={baslik} aciklama={girdi.data.tanim} isaretleme={isaretleme}>
  <KirintiYolu basamaklar={[...fazBasamagi(girdi.id), { ad: baslik }]} />

  <h1>{baslik}</h1>

  {/* İlk paragraf doğrudan tanımla açılır — hikâyeyle açılan sayfa alıntılanmaz */}
  <p class="tanim">{girdi.data.tanim}</p>

  <Content />

  {
    asama && (
      <section>
        <h2>Algoritmalar</h2>
        <ul class="algoritmalar">
          {asama.algoritmalar.map((algoritma) => (
            <AlgoritmaSatiri algoritma={algoritma} diziler={baglar} />
          ))}
        </ul>
      </section>
    )
  }

  {
    diziler.length > 0 && (
      <section>
        <h2>Diziler</h2>
        <ul class="dizi-kartlari">
          {diziler.map((dizi) => {
            const [, diziId] = dizi.id.split('/')
            return (
              <li>
                <h3>
                  <a href={`/${girdi.id}/${diziId}/`}>{dizi.data.baslik}</a>
                </h3>
                <p>{dizi.data.ozet}</p>
              </li>
            )
          })}
        </ul>
      </section>
    )
  }

  {
    tekilYazilar.length > 0 && (
      <section>
        <h2>Yazılar</h2>
        <ul class="yazi-listesi">
          {tekilYazilar.map((yazi) => (
            <li>
              <h3>
                <a href={yazi.adres}>{yazi.baslik}</a>
              </h3>
              <p>{yazi.ozet}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    !asama && (
      <section>
        <h2>Başvuru</h2>
        <ul>
          <li><a href="/sozluk/">Sözlük</a> — terimlerin tanımları</li>
          <li><a href="/veri-seti/">Veri seti</a> — bütün vakaların kullandığı veri</li>
        </ul>
      </section>
    )
  }
</Temel>
