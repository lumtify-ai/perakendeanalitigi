---
// site/src/pages/[alan]/[yazi].astro
import { getCollection, getEntry, render } from 'astro:content'
import Yazi from '../../layouts/Yazi.astro'
import { yaziBasliklari } from '../../lib/basliklar'
import { yaziYolunuAyristir } from '../../lib/yol'
import { zorunlu } from '../../lib/zorunlu'
import { alanBasligi } from '../../lib/alanBasligi'
import { fazBasamagi } from '../../lib/haritaGirdisi'

export async function getStaticPaths() {
  const yazilar = await getCollection('yazi')

  return yazilar
    .filter((girdi) => yaziYolunuAyristir(girdi.id).dizi === null)
    .map((girdi) => {
      const yol = yaziYolunuAyristir(girdi.id)
      return {
        params: { alan: yol.alan, yazi: yol.slug },
        props: { girdi },
      }
    })
}

const { girdi } = Astro.props
const yol = yaziYolunuAyristir(girdi.id)
const { Content, headings } = await render(girdi)
const basliklar = yaziBasliklari(headings)
const alanGirdi = zorunlu(await getEntry('alan', yol.alan), 'alan', yol.alan)
---

<Yazi
  baslik={girdi.data.baslik}
  ozet={girdi.data.ozet}
  tip={girdi.data.tip}
  yazar={girdi.data.yazar}
  durum={girdi.data.durum}
  basliklar={basliklar}
  basamaklar={[
    ...fazBasamagi(yol.alan),
    { ad: alanBasligi(yol.alan, alanGirdi.data), adres: `/${yol.alan}/` },
    { ad: girdi.data.baslik },
  ]}
>
  <Content />
</Yazi>
