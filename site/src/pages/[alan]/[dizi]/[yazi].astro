---
// site/src/pages/[alan]/[dizi]/[yazi].astro
import { getCollection, getEntry, render } from 'astro:content'
import Yazi from '../../../layouts/Yazi.astro'
import { diziYazilari } from '../../../lib/agac'
import { yaziYolunuAyristir } from '../../../lib/yol'
import { zorunlu } from '../../../lib/zorunlu'

export async function getStaticPaths() {
  const yazilar = await getCollection('yazi')

  return yazilar
    .filter((girdi) => yaziYolunuAyristir(girdi.id).dizi !== null)
    .map((girdi) => {
      const yol = yaziYolunuAyristir(girdi.id)
      return {
        params: { alan: yol.alan, dizi: yol.dizi, yazi: yol.slug },
        props: { girdi },
      }
    })
}

const { girdi } = Astro.props
const yol = yaziYolunuAyristir(girdi.id)
const { Content } = await render(girdi)

const diziId = `${yol.alan}/${yol.dizi}`
const [hamAlan, hamDizi, hepsi] = await Promise.all([
  getEntry('alan', yol.alan),
  getEntry('dizi', diziId),
  getCollection('yazi'),
])
const alanGirdi = zorunlu(hamAlan, 'alan', yol.alan)
const diziGirdi = zorunlu(hamDizi, 'dizi', diziId)

const sirali = diziYazilari(hepsi, yol.alan, yol.dizi!)
const diziAdresi = `/${yol.alan}/${yol.dizi}/`
---

<Yazi
  baslik={girdi.data.baslik}
  ozet={girdi.data.ozet}
  tip={girdi.data.tip}
  yazar={girdi.data.yazar}
  durum={girdi.data.durum}
  basamaklar={[
    { ad: alanGirdi.data.baslik, adres: `/${yol.alan}/` },
    { ad: diziGirdi.data.baslik, adres: diziAdresi },
    { ad: girdi.data.baslik },
  ]}
  dizi={{
    baslik: diziGirdi.data.baslik,
    adres: diziAdresi,
    sirali,
    suanki: yol.slug,
  }}
>
  <Content />
</Yazi>
