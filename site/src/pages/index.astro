---
// site/src/pages/index.astro
//
// Ana sayfa haritanın kendisidir: sezon ekseninin iki fazı (Sezon Öncesi,
// Sezon İçi) yan yana, altlarında tam genişlikte Diğer Süreçler, en altta
// harita dışı Temeller rafı (spec §0.1 madde 8). Aşama ve algoritmaların
// sırası src/data/harita.ts'den gelir; bu dosya sıra tutmaz.
import { getCollection, getEntry } from 'astro:content'
import Temel from '../layouts/Temel.astro'
import FazHaritasi from '../components/FazHaritasi.astro'
import { HARITA, TEMELLER, type FazSlug } from '../data/harita'
import { alanYazilari } from '../lib/agac'
import { alanBasligi } from '../lib/alanBasligi'
import { diziBaglari } from '../lib/haritaGirdisi'
import { zorunlu } from '../lib/zorunlu'

const [diziler, yazilar, hamTemeller] = await Promise.all([
  getCollection('dizi'),
  getCollection('yazi'),
  getEntry('alan', TEMELLER),
])
const baglar = diziBaglari(diziler, yazilar)
// Sezon ekseninin dışındaki faz ayrı satırda durur; geri kalanı yan yana.
const EKSEN_DISI: FazSlug = 'diger-surecler'
const eksendekiler = HARITA.filter((faz) => faz.slug !== EKSEN_DISI)
const eksenDisi = HARITA.filter((faz) => faz.slug === EKSEN_DISI)
const temeller = zorunlu(hamTemeller, 'alan', TEMELLER)
const temelYazilari = alanYazilari(yazilar, TEMELLER)

const TANIM =
  'Perakende analitiği, mağaza ve ürün verisini kullanarak stok, fiyat ve ' +
  'dağıtım kararlarını ölçülebilir hâle getirme işidir. Bu sitede her problem ' +
  'somut bir soruyla başlar, matematiksel modeliyle kurulur ve SQL ile Python ' +
  'çözümüyle uçtan uca gösterilir.'
---

<Temel baslik="Perakende Analitiği" aciklama={TANIM}>
  <h1>Perakende Analitiği</h1>
  <p class="tanim">{TANIM}</p>
  <p>
    Bütün çözümler tek bir açık veri setinin üzerinde çalışır:
    <a href="/veri-seti/">Lumoda</a>, 25 mağazalık kurgusal bir moda
    perakende zinciri. Veri, kod ve model açıktır; hiçbiri form arkasında
    değildir.
  </p>

  {/* Üst menüdeki "Harita" bağlantısının hedefi (tasarım dokümanı §9) */}
  <section id="harita" class="harita">
    <div class="harita-fazlari">
      {
        eksendekiler.map((faz) => (
          <section class="faz">
            <h2>
              <a href={`/${faz.slug}/`}>{faz.ad}</a>
            </h2>
            <FazHaritasi faz={faz} diziler={baglar} baslikSeviyesi={3} />
          </section>
        ))
      }
    </div>

    {
      eksenDisi.map((faz) => (
        <section class="faz faz--eksen-disi">
          <h2>
            <a href={`/${faz.slug}/`}>{faz.ad}</a>
          </h2>
          <FazHaritasi faz={faz} diziler={baglar} baslikSeviyesi={3} />
        </section>
      ))
    }

    <section class="temeller-rafi">
      <h2>
        <a href={`/${TEMELLER}/`}>{alanBasligi(TEMELLER, temeller.data)}</a>
      </h2>
      <p>{temeller.data.tanim}</p>
      <ul class="yazi-listesi">
        {
          temelYazilari.map((yazi) => (
            <li>
              <a href={yazi.adres}>{yazi.baslik}</a>
            </li>
          ))
        }
        <li><a href="/sozluk/">Sözlük</a> — terimlerin tanımları</li>
        <li><a href="/veri-seti/">Veri seti</a> — bütün vakaların kullandığı veri</li>
      </ul>
    </section>
  </section>

  <section class="kim-yaziyor">
    <h2>Kim yazıyor</h2>
    <p>
      Bu site <a href="https://lumtify.com">Lumtify</a>'ın perakende analitiği
      çalışmalarının açık kısmıdır. Hikâyelerdeki
      <a href="/kadro/">Ali, Veli ve Pelin</a> kurgusaldır; problemler
      değildir.
    </p>
  </section>
</Temel>
