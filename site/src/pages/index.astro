---
// site/src/pages/index.astro
import { getCollection } from 'astro:content'
import Temel from '../layouts/Temel.astro'
import { alanYazilari, diziYazilari } from '../lib/agac'
import { alanBasligi } from '../lib/alanBasligi'
import { asamaBul } from '../data/harita'

const [alanlar, diziler, yazilar] = await Promise.all([
  getCollection('alan'),
  getCollection('dizi'),
  getCollection('yazi'),
])

// Geçici: aşamalar harita sırasıyla, Temeller (haritada yok) başta. Ana
// sayfanın faz düzenine geçişi ayrı bir adımda.
const sirali = alanlar.sort(
  (a, b) => (asamaBul(a.id)?.asama.no ?? 0) - (asamaBul(b.id)?.asama.no ?? 0),
)

const agac = sirali.map((alan) => ({
  alan,
  diziler: diziler
    .filter((d) => d.data.alan === alan.id)
    .map((dizi) => {
      const [, diziId] = dizi.id.split('/')
      return { dizi, diziId, yazilar: diziYazilari(yazilar, alan.id, diziId) }
    }),
  tekilYazilar: alanYazilari(yazilar, alan.id),
}))

const TANIM =
  'Perakende analitiği, mağaza ve ürün verisini kullanarak stok, fiyat ve ' +
  'dağıtım kararlarını ölçülebilir hâle getirme işidir. Bu sitede her problem ' +
  'somut bir soruyla başlar, matematiksel modeliyle kurulur ve SQL ile Python ' +
  'çözümüyle uçtan uca gösterilir.'
---

<Temel baslik="Perakende Analitiği" aciklama={TANIM}>
  <h1>Perakende Analitiği</h1>
  <p class="tanim">{TANIM}</p>
  <p>
    Bütün çözümler tek bir açık veri setinin üzerinde çalışır:
    <a href="/veri-seti/">Lumoda</a>, 25 mağazalık kurgusal bir moda
    perakende zinciri. Veri, kod ve model açıktır; hiçbiri form arkasında
    değildir.
  </p>

  {/* Üst menüdeki "Alanlar" bağlantısının hedefi (tasarım dokümanı §9) */}
  <section id="alanlar" class="agac">
    <h2 class="agac-basligi">Alanlar</h2>

  {
    agac.map(({ alan, diziler: altDiziler, tekilYazilar }) => (
      <section class="alan-bolumu">
        <h3>
          <a href={`/${alan.id}/`}>{alanBasligi(alan.id, alan.data)}</a>
        </h3>
        <p>{alan.data.tanim}</p>

        {altDiziler.length > 0 && (
          <ul class="dizi-listesi">
            {altDiziler.map(({ dizi, diziId, yazilar: uyeler }) => (
              <li>
                <a href={`/${alan.id}/${diziId}/`}>{dizi.data.baslik}</a>
                <span class="sayac"> · {uyeler.length} yazı</span>
              </li>
            ))}
          </ul>
        )}

        {tekilYazilar.length > 0 && (
          <ul class="yazi-listesi">
            {tekilYazilar.map((yazi) => (
              <li>
                <a href={yazi.adres}>{yazi.baslik}</a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
  </section>

  <section class="kim-yaziyor">
    <h2>Kim yazıyor</h2>
    <p>
      Bu site <a href="https://lumtify.com">Lumtify</a>'ın perakende analitiği
      çalışmalarının açık kısmıdır. Hikâyelerdeki
      <a href="/kadro/">Ali, Veli ve Pelin</a> kurgusaldır; problemler
      değildir.
    </p>
  </section>
</Temel>
