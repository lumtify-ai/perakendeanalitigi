---
// site/src/components/Lumtify.astro
// Tek geçiş noktası. Yalnızca bir dizinin SON yazısında bulunabilir; build
// doğrulaması bunu zorunlu kılar (src/lib/dogrula.ts). Kural yazının tipine
// değil, okuyucunun diziyi nerede bitirdiğine bakar.
//
// Buradaki tanım cümlesi KANONİKTİR: sitede, LinkedIn'de ve GitHub
// deposunun açıklamasında birebir aynı geçer (ana spec §9, varlık
// tutarlılığı). Değiştirilecekse üçü birden değişir.
//
// İlk ve son paragraf dizi başına değiştirilebilir (R29). Bileşenin içine
// yazılan içerik (varsayılan slot) ilk paragrafın, `slot="son"` taşıyan
// öğe son paragrafın yerine geçer. Verilmeyen paragraf için aşağıdaki
// varsayılan metin basılır; o metinler blok-transfer için yazıldı ve
// içerik vermeyen dizilerin sayfaları değişmesin diye aynen kalır. Başlık
// ve kanonik tanım cümlesi her durumda aynıdır.
//
//   <Lumtify>
//
//   Bu dizinin hesabı ... (dizinin kendi giriş paragrafı)
//
//   <Fragment slot="son">
//
//   ... (dizinin kendi son paragrafı)
//
//   </Fragment>
//
//   </Lumtify>
const diziGirisi = Astro.slots.has('default')
const diziSonu = Astro.slots.has('son')
---

<aside class="lumtify-koprusu">
  <h2>Bu modeli kendi zincirinizde çalıştırmak</h2>
  {
    diziGirisi ? (
      <slot />
    ) : (
      <p>
        Yukarıdaki hesap yayımlanabilir olması için sadeleştirildi. Gerçek bir
        zincirde marj üründen ürüne değişir, kargo tarifesi rotaya göre değişir ve
        aynı mal sezon içinde birden çok kez taşınır — yani bu yazının en zayıf
        yeri olarak işaretlediğim tek atışlık varsayım sizde en baştan tutmaz.
      </p>
    )
  }
  <p>
    <strong>
      <a href="https://lumtify.com">Lumtify</a>, iş zekâsı ve optimizasyonla
      perakendede işleri akıllı hale getirir.
    </strong>{' '}
    Adı da oradan geliyor: <em>Let Us Make Trade Intelligent For You</em>.
  </p>
  {
    diziSonu ? (
      <slot name="son" />
    ) : (
      <p>
        Maliyet kalemlerinizi kendi tarifenizle kurar, satma ihtimallerini sizin
        geçmiş verinizden tahmin eder ve başabaş eşiğini kendi mağaza sayınızla
        hesaplar.
      </p>
    )
  }
</aside>
