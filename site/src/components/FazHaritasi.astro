---
// site/src/components/FazHaritasi.astro
//
// Bir fazın aşamaları ve algoritmaları, içindekiler düzeninde (spec §4).
// Her aşama bir satır: numara · ad · sağda "aktif/toplam". Aktif aşama açık:
// adı kendi sayfasına bağlanır, algoritmaları altında durum noktalı bir
// liste. Soluk aşamanın sayfası yoktur; adı düz metin, algoritmaları tek
// satırda "·" ile ayrılmış, hiçbiri bağlantı değil.
// Başlık seviyesi dışarıdan gelir: faz sayfasında aşamalar h2, ana sayfada
// faz adı h2 olduğu için h3.
import type { Faz } from '../data/harita'
import { asamaAktifMi, asamaIlerlemesi, type DiziBagi } from '../lib/haritaDurumu'
import AlgoritmaSatiri from './AlgoritmaSatiri.astro'

interface Props {
  faz: Faz
  diziler: DiziBagi[]
  baslikSeviyesi?: 2 | 3
}

const { faz, diziler, baslikSeviyesi = 2 } = Astro.props
const Baslik = `h${baslikSeviyesi}` as 'h2' | 'h3'
---

<ol class="faz-haritasi">
  {
    faz.asamalar.map((asama) => {
      const aktif = asamaAktifMi(asama, diziler)
      const ilerleme = asamaIlerlemesi(asama, diziler)
      return (
        <li class={`asama asama--${aktif ? 'aktif' : 'soluk'}`}>
          <div class="asama-satiri">
            <Baslik class="asama-basligi">
              <span class="asama-no">{String(asama.no).padStart(2, '0')}</span>{' '}
              {aktif ? <a href={`/${asama.slug}/`}>{asama.ad}</a> : <span>{asama.ad}</span>}
            </Baslik>
            <span class="asama-ilerleme">{ilerleme.aktif}/{ilerleme.toplam}</span>
            <span class="sr-only"> algoritma yazıldı</span>
          </div>
          {aktif ? (
            <ul class="algoritmalar">
              {asama.algoritmalar.map((algoritma) => (
                <AlgoritmaSatiri algoritma={algoritma} diziler={diziler} />
              ))}
            </ul>
          ) : (
            <p class="soluk-algoritmalar">
              {asama.algoritmalar.map((algoritma, i) => (
                <>
                  {i > 0 && <span class="ayrac" aria-hidden="true"> · </span>}
                  <span class="algoritma algoritma--soluk">{algoritma.ad} <span class="sr-only">yazılmadı</span></span>
                </>
              ))}
            </p>
          )}
        </li>
      )
    })
  }
</ol>
