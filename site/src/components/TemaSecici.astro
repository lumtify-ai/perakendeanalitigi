---
// site/src/components/TemaSecici.astro
//
// GELİŞTİRME ARACI — üretim derlemesine girmez.
//
// Temel.astro bunu yalnızca `import.meta.env.DEV` iken basar. Sebebi
// sitenin en sert kurallarından biri: üretilen HTML'de application/ld+json
// dışında <script> bulunamaz (tests/build.test.ts). Canlıda tema
// değiştirici olamaz; aday temaları gezerek karşılaştırmak ise geliştirme
// sırasında gereken bir iş.
//
// DİKKAT — neden set:html: Astro, .astro dosyasındaki <script>/<style>
// etiketlerini DERLEME anında toplar ve koşullu render bunu engellemez;
// `is:inline` ile denendi, script yine üretim HTML'ine düştü. Bu yüzden
// hepsi metin olarak veriliyor: derleyici burada bir script etiketi
// görmüyor, dolayısıyla toplayamıyor. Aynı teknik Demo.astro'da da var.
const ADAYLAR = [
  { kod: 'a', ad: 'A · Editorial' },
  { kod: 'b', ad: 'B · Defter' },
]

const stil = `
.tema-secici { position: fixed; right: 1rem; bottom: 1rem; z-index: 999;
  display: flex; align-items: center; gap: .35rem; padding: .35rem .5rem;
  border-radius: .5rem; background: var(--kutu-zemin);
  border: 1px solid var(--cizgi); font-family: var(--arayuz);
  font-size: .75rem; box-shadow: 0 2px 10px rgb(0 0 0 / .12); }
.tema-secici .tema-etiket { color: var(--soluk); letter-spacing: .06em; text-transform: uppercase }
.tema-secici button { border: 1px solid var(--cizgi); background: transparent;
  color: var(--ink); border-radius: .35rem; padding: .2rem .5rem;
  cursor: pointer; font: inherit }
.tema-secici button[aria-pressed="true"] { background: var(--vurgu);
  border-color: var(--vurgu); color: #fff }
`

const dugmeler = ADAYLAR.map(
  ({ kod, ad }) => `<button type="button" data-tema-kod="${kod}">${ad}</button>`,
).join('')

const komut = `
;(function () {
  var kok = document.documentElement
  function uygula(kod) {
    if (kod === 'a') kok.removeAttribute('data-tema')
    else kok.setAttribute('data-tema', kod)
    try { localStorage.setItem('aday-tema', kod) } catch (e) {}
    document.querySelectorAll('[data-tema-kod]').forEach(function (d) {
      d.setAttribute('aria-pressed', String(d.dataset.temaKod === kod))
    })
  }
  document.addEventListener('click', function (e) {
    var d = e.target.closest && e.target.closest('[data-tema-kod]')
    if (d) uygula(d.dataset.temaKod)
  })
  var secili = 'a'
  try { secili = localStorage.getItem('aday-tema') || 'a' } catch (e) {}
  uygula(secili)
})()
`

const govde = [
  '<link rel="stylesheet" href="/temalar/b-defter.css">',
  '<style>' + stil + '</style>',
  '<div class="tema-secici" role="group" aria-label="Aday tema (yalnız geliştirme)">',
  '<span class="tema-etiket">tema</span>',
  dugmeler,
  '</div>',
  '<script>' + komut + '<\/script>',
].join('')
---

<Fragment set:html={govde} />
