---
// site/src/components/AlgoritmaSatiri.astro
//
// Haritadaki tek bir algoritma, iki durumdan biriyle: aktif ya da soluk
// (src/lib/haritaDurumu.ts).
// Faz sayfası, ana sayfa ve aşama sayfası aynı satırı basar ki bir durumun
// görünüşü üç yerde ayrışmasın. Sınıf adları sabittir; tasarım turu onlara
// bağlanacak.
import type { Algoritma } from '../data/harita'
import { algoritmaDurumu, type DiziBagi } from '../lib/haritaDurumu'
import DiziEtiketi from './DiziEtiketi.astro'
import DurumNoktasi from './DurumNoktasi.astro'

interface Props {
  algoritma: Algoritma
  diziler: DiziBagi[]
}

const { algoritma, diziler } = Astro.props
const durum = algoritmaDurumu(algoritma.id, diziler)
---

<li class={`algoritma algoritma--${durum.tur}`}>
  <DurumNoktasi aktif={durum.tur === 'aktif'}><span class="algoritma-adi">{algoritma.ad}</span></DurumNoktasi>
  {
    durum.tur === 'aktif' && (
      <span class="algoritma-dizileri">
        {durum.diziler.map((dizi) => (
          <DiziEtiketi baslik={dizi.baslik} adres={dizi.adres} yaziSayisi={dizi.yaziSayisi} />
        ))}
      </span>
    )
  }
</li>
