---
// site/src/components/DiziGezinme.astro
import type { YaziOzet } from '../lib/agac'

import { komsular } from '../lib/agac'

interface Props {
  sirali: YaziOzet[]
  suanki: string
  diziBasligi: string
  diziAdresi: string
}

const { sirali, suanki, diziBasligi, diziAdresi } = Astro.props
const { onceki, sonraki } = komsular(sirali, suanki)
---

<nav class="dizi-gezinme" aria-label="Dizideki yazılar">
  <p class="dizi-adi">
    <a href={diziAdresi}>{diziBasligi}</a> dizisi
  </p>
  <ol>
    {
      sirali.map((yazi) => (
        <li class={yazi.slug === suanki ? 'suanki' : undefined}>
          {yazi.slug === suanki ? (
            <span aria-current="page">{yazi.baslik}</span>
          ) : (
            <a href={yazi.adres}>{yazi.baslik}</a>
          )}
          {yazi.durum === 'hazirlaniyor' && <span class="durum"> · hazırlanıyor</span>}
        </li>
      ))
    }
  </ol>

  <div class="komsular">
    {onceki && <a rel="prev" href={onceki.adres}>← {onceki.baslik}</a>}
    {sonraki && <a rel="next" href={sonraki.adres}>{sonraki.baslik} →</a>}
  </div>
</nav>
