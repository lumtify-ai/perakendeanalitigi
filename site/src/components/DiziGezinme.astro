---
// site/src/components/DiziGezinme.astro
//
// Yazının sonunda dizi adı ve önceki/sonraki. Dizinin sıralı listesi
// buradan sol menüye (DiziYanMenu.astro) taşındı (spec §6); okur yazıyı
// bitirdiğinde ihtiyacı olan tek şey bir sonraki adım.
import type { YaziOzet } from '../lib/agac'

import { komsular } from '../lib/agac'

interface Props {
  sirali: YaziOzet[]
  suanki: string
  diziBasligi: string
  diziAdresi: string
}

const { sirali, suanki, diziBasligi, diziAdresi } = Astro.props
const { onceki, sonraki } = komsular(sirali, suanki)
---

<nav class="dizi-gezinme" aria-label="Dizide önceki ve sonraki yazı">
  <p class="dizi-adi">
    <a href={diziAdresi}>{diziBasligi}</a> dizisi
  </p>

  <div class="komsular">
    {onceki && <a rel="prev" href={onceki.adres}>← {onceki.baslik}</a>}
    {sonraki && <a rel="next" href={sonraki.adres}>{sonraki.baslik} →</a>}
  </div>
</nav>
