---
// site/src/components/FazKarti.astro
//
// Faz kartı (spec §3): faz adı faz sayfasına bağlanır, altında ilerleme
// sayacı "a / t algoritma yazıldı" — faz sayfasının başında yazan sayacın
// aynısı (fazIlerlemesi). Kart süreç hattındaki segmentin başlığıdır; faz
// adı sayfada ikinci kez, ayrı bir kart satırında tekrarlanmaz
// (SurecHatti.astro).
import type { Faz } from '../data/harita'
import { fazIlerlemesi, type DiziBagi } from '../lib/haritaDurumu'

interface Props {
  faz: Faz
  diziler: DiziBagi[]
}

const { faz, diziler } = Astro.props
const ilerleme = fazIlerlemesi(faz, diziler)
---

<header class="faz-karti">
  <h3 class="hat-fazi"><a class="faz-karti-adi" href={`/${faz.slug}/`}>{faz.ad}</a></h3>
  <p class="faz-karti-ilerleme">{ilerleme.aktif} / {ilerleme.toplam} algoritma yazıldı</p>
</header>
