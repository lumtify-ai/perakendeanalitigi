---
// site/src/layouts/Yazi.astro
import Temel from './Temel.astro'
import KirintiYolu from '../components/KirintiYolu.astro'
import Rozet from '../components/Rozet.astro'
import DiziGezinme from '../components/DiziGezinme.astro'
import DiziYanMenu from '../components/DiziYanMenu.astro'
import BuYazida from '../components/BuYazida.astro'
import type { YaziOzet } from '../lib/agac'

interface Props {
  baslik: string
  ozet: string
  tip: 'hikaye' | 'anlatici' | 'teknik' | 'sonuc'
  yazar: string
  durum: string
  basamaklar: { ad: string; adres?: string }[]
  dizi?: { baslik: string; adres: string; sirali: YaziOzet[]; suanki: string }
  /** Yazının h2 başlıkları (render() → headings, derinlik 2). */
  basliklar: { slug: string; text: string }[]
}

const { baslik, ozet, tip, yazar, durum, basamaklar, dizi, basliklar } = Astro.props

// Sağ menü ("Bu yazıda") hikâyede basılmaz (spec §0.4, §6): hikâye baştan
// sona okunur, bölüm atlamaya davet etmez. h2'siz yazıda da basılmaz.
const sagMenu = tip === 'hikaye' ? [] : basliklar
// Sağ sütun boşsa geniş öğeler (pre, KaTeX, demo, tablo) oraya taşabilir;
// doluysa taşmaz, çünkü sticky menü ile çakışır (site.css · yazı düzeni).
const duzenSinifi = sagMenu.length > 0 ? 'yazi-duzeni' : 'yazi-duzeni yazi-duzeni--sag-bos'

// Teknik içerik TechArticle, anlatı Article olarak işaretlenir
const tur = tip === 'teknik' || tip === 'sonuc' ? 'TechArticle' : 'Article'

const isaretleme = {
  '@context': 'https://schema.org',
  '@type': tur,
  headline: baslik,
  description: ozet,
  author: { '@type': 'Person', name: yazar },
  publisher: { '@type': 'Organization', name: 'Lumtify' },
  inLanguage: 'tr',
}
---

<Temel
  baslik={baslik}
  aciklama={ozet}
  isaretleme={isaretleme}
  dizinlenmesin={durum === 'hazirlaniyor'}
  duzen="yazi"
>
  <div class={duzenSinifi}>
    <div class="yazi-govdesi">
      <KirintiYolu basamaklar={basamaklar} />

      <article>
        <header>
          <Rozet tip={tip} />
          <h1>{baslik}</h1>
          <p class="ozet">{ozet}</p>
          {durum === 'hazirlaniyor' && <p class="uyari">Bu yazı hazırlanıyor.</p>}
          {
            dizi && (
              <DiziYanMenu
                diziBasligi={dizi.baslik}
                diziAdresi={dizi.adres}
                sirali={dizi.sirali}
                suanki={dizi.suanki}
                bicim="kutu"
              />
            )
          }
        </header>

        <slot />

        <footer>
          <p class="yazar">Yazan: {yazar}</p>
        </footer>
      </article>

      {
        dizi && (
          <DiziGezinme
            sirali={dizi.sirali}
            suanki={dizi.suanki}
            diziBasligi={dizi.baslik}
            diziAdresi={dizi.adres}
          />
        )
      }
    </div>

    {
      /* Sol menü görselde solda (grid-column: 1, site.css · yazı düzeni) ama
         işaretlemede yazının arkasında: ekran okuyucu ve klavye önce kırıntı
         yoluna, başlığa ve yazıya gelir; atlama bağlantısı gerekmez. */
      dizi && (
        <DiziYanMenu
          diziBasligi={dizi.baslik}
          diziAdresi={dizi.adres}
          sirali={dizi.sirali}
          suanki={dizi.suanki}
        />
      )
    }

    <BuYazida basliklar={sagMenu} />
  </div>
</Temel>
