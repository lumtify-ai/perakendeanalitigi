---
// site/src/layouts/Temel.astro
import '../styles/site.css'
import TemaSecici from '../components/TemaSecici.astro'

interface Props {
  baslik: string
  aciklama: string
  isaretleme?: Record<string, unknown>
  /** Sayfa arama motorlarına ve yapay zekâ tarayıcılarına kapatılsın mı? */
  dizinlenmesin?: boolean
}

const { baslik, aciklama, isaretleme, dizinlenmesin = false } = Astro.props
const tamBaslik = baslik === 'perakendeanalitigi.com'
  ? baslik
  : `${baslik} · perakendeanalitigi.com`

const kurum = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Lumtify',
  url: 'https://lumtify.com',
  subjectOf: Astro.site?.href,
}
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    {
      /* Gövdesi tek cümlelik bir yer tutucu sayfa, ilk taramada geri alması en
         zor birinci izlenimi bırakır. Sayfa üretilmeye devam eder — dizi
         kapağı ona bağlanıyor — ama indekslenmez. */
      dizinlenmesin && <meta name="robots" content="noindex" />
    }
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(kurum)} is:inline />
    {
      isaretleme && (
        <script type="application/ld+json" set:html={JSON.stringify(isaretleme)} is:inline />
      )
    }
  </head>
  <body>
    <header>
      <a href="/tr/" class="logo">perakendeanalitigi.com</a>
      <nav>
        {/* Tasarım dokümanı §9. "Alanlar" ayrı bir sayfa değil, ana sayfadaki
            ağaç bölümüne çapa: ana sayfa zaten o haritadır. "Hakkında" yerine
            "Kadro" duruyor; gerekçesi tasarım dokümanı §9'da. */}
        <a href="/tr/#alanlar">Alanlar</a>
        <a href="/tr/veri-seti/">Veri seti</a>
        <a href="/tr/sozluk/">Sözlük</a>
        <a href="/tr/kadro/">Kadro</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    {/* Aday tema değiştirici: YALNIZ `astro dev` sunucusunda basılır.
        Koşul bilerek MODE === 'development'; `import.meta.env.DEV` denendi
        ve yetmedi — vitest build'i NODE_ENV=test ile koşturduğu için DEV
        orada da true kalıyor ve script üretim HTML'ine sızıyordu. Sitenin
        "ld+json dışında <script> yok" vaadi bu koşula bağlı olamaz; ayrıca
        tests/build.test.ts bunu zaten bağımsız olarak kilitliyor. */}
    {import.meta.env.MODE === 'development' && <TemaSecici />}

    <footer>
      <p>
        Bir <a href="https://lumtify.com">Lumtify</a> projesi. Bütün veriler
        sentetiktir; Lumoda kurgusal bir zincirdir.
      </p>
    </footer>
  </body>
</html>
